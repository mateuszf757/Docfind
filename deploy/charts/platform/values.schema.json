{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Wartości charta docfind-platform",
  "description": "Bez schematu Helm po cichu ignoruje nieznany klucz — literówka w nazwie wydawcy albo hosta dawałaby Gateway bez certyfikatu bez żadnego sygnału przy renderze.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "parts",
    "gateway",
    "certificate",
    "internalCA",
    "acme",
    "proxy",
    "secretStore"
  ],
  "properties": {
    "global": {
      "type": "object",
      "description": "Helm dokłada `global` do wartości każdego charta."
    },
    "parts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pki",
        "ingress"
      ],
      "description": "Części charta (decyzja 81): Helm instaluje obie, Argo CD każdą jako osobną Application. Żadna — chart bez zasobów, czyli pomyłka w wartościach.",
      "properties": {
        "pki": {
          "type": "boolean"
        },
        "ingress": {
          "type": "boolean"
        }
      },
      "anyOf": [
        {
          "properties": {
            "pki": {
              "const": true
            }
          }
        },
        {
          "properties": {
            "ingress": {
              "const": true
            }
          }
        }
      ]
    },
    "gateway": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "hostname",
        "issuer",
        "httpsRedirectPort",
        "routeNamespaceLabel"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
        },
        "hostname": {
          "type": "string",
          "pattern": "^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]{2,63}$",
          "maxLength": 253,
          "description": "Nazwa DNS małymi literami. Długość osobno w maxLength — Helm waliduje schemat regexpami RE2, bez lookahead."
        },
        "issuer": {
          "enum": [
            "docfind-internal-ca",
            "letsencrypt-staging",
            "letsencrypt"
          ]
        },
        "httpsRedirectPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "routeNamespaceLabel": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "key",
            "value"
          ],
          "properties": {
            "key": {
              "type": "string",
              "minLength": 1
            },
            "value": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "certificate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "duration",
        "renewBefore"
      ],
      "properties": {
        "duration": {
          "type": "string",
          "pattern": "^[0-9]+h$",
          "description": "Czas w godzinach, np. 2160h — format adnotacji cert-managera."
        },
        "renewBefore": {
          "type": "string",
          "pattern": "^[0-9]+h$",
          "description": "Czas w godzinach, np. 2160h — format adnotacji cert-managera."
        }
      }
    },
    "internalCA": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "duration",
        "renewBefore"
      ],
      "properties": {
        "duration": {
          "type": "string",
          "pattern": "^[0-9]+h$",
          "description": "Czas w godzinach, np. 2160h — format adnotacji cert-managera."
        },
        "renewBefore": {
          "type": "string",
          "pattern": "^[0-9]+h$",
          "description": "Czas w godzinach, np. 2160h — format adnotacji cert-managera."
        }
      }
    },
    "acme": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "email",
        "dnsZone",
        "tokenSecretName"
      ],
      "properties": {
        "email": {
          "type": "string",
          "description": "Pusty — wydawcy Let's Encrypt nie powstają.",
          "anyOf": [
            {
              "const": ""
            },
            {
              "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$"
            }
          ]
        },
        "dnsZone": {
          "type": "string",
          "anyOf": [
            {
              "const": ""
            },
            {
              "pattern": "^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]{2,63}$",
              "maxLength": 253
            }
          ]
        },
        "tokenSecretName": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "proxy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "replicas",
        "resources",
        "drainTimeoutSeconds",
        "shutdownManagerMemoryLimit"
      ],
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 1
        },
        "resources": {
          "type": "object"
        },
        "drainTimeoutSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "shutdownManagerMemoryLimit": {
          "type": "string",
          "pattern": "^[0-9]+(Mi|Gi)$"
        }
      }
    },
    "secretStore": {
      "type": "object",
      "additionalProperties": false,
      "description": "OpenBao przez External Secrets Operator (decyzje 42 i 43).",
      "required": [
        "name",
        "server",
        "mount",
        "authMount",
        "audience",
        "serviceAccount",
        "dnsTokenRole",
        "dnsTokenPath",
        "refreshInterval"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
        },
        "server": {
          "type": "string",
          "pattern": "^https://",
          "description": "Tylko TLS: przez to połączenie idą tokeny i wartości."
        },
        "mount": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
        },
        "authMount": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
        },
        "audience": {
          "type": "string",
          "minLength": 1
        },
        "serviceAccount": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
        },
        "dnsTokenRole": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
        },
        "dnsTokenPath": {
          "type": "string",
          "pattern": "^[a-z0-9-]+(/[a-z0-9-]+)*$"
        },
        "refreshInterval": {
          "type": "string",
          "pattern": "^[0-9]+(s|m|h)$"
        }
      }
    }
  }
}
