{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Wartości charta docfind",
  "description": "Chart jest publicznym interfejsem produktu (docs/DECYZJE.md, decyzja 13). Bez schematu Helm po cichu ignoruje nieznany klucz — literówka `api.replica: 3` dawałaby dwie repliki bez żadnego sygnału. Draft-07, żeby schemat działał także w Helmie 3 u klienta.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": {
      "description": "Helm dokłada `global` do wartości każdego charta.",
      "type": "object"
    },
    "api": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "replicas",
        "image",
        "resources",
        "preStopSleepSeconds",
        "terminationGracePeriodSeconds",
        "config",
        "secrets"
      ],
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 1
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository",
            "tag",
            "pullPolicy"
          ],
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "description": "Wymagany przy renderze (szablon odmawia pustego) — bez domyślnego latest.",
              "type": "string"
            },
            "digest": {
              "description": "Opcjonalny digest obrazu z publikacji w CI; podany daje repository:tag@digest. Pełny sha256 — skrócony albo z literówką odpadłby dopiero przy pobieraniu obrazu na węźle.",
              "type": "string",
              "pattern": "^(sha256:[a-f0-9]{64})?$"
            },
            "pullPolicy": {
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            }
          }
        },
        "version": {
          "description": "Wersja wdrożenia dla /version (zmienna DOCFIND_VERSION, decyzja 40): wydanie X.Y.Z albo wersja deweloperska z gita; pusta — /version podaje unknown. Bez tagu v z przodu: to wersja, nie tag wydania.",
          "type": "string",
          "pattern": "^$|^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$"
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "requests",
            "limits"
          ],
          "properties": {
            "requests": {
              "$ref": "#/definitions/quantities"
            },
            "limits": {
              "$ref": "#/definitions/quantities"
            }
          }
        },
        "preStopSleepSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "terminationGracePeriodSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "config": {
          "description": "Treść app.yml. Waliduje ją model Pydantic — w CI na wyrenderowanej ConfigMapie i przy starcie poda (deploy/config/app.schema.json).",
          "type": "object"
        },
        "secrets": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "secretName",
            "externalSecret"
          ],
          "description": "Sekrety aplikacji jako pliki w /run/secrets (decyzja 44).",
          "properties": {
            "secretName": {
              "type": "string",
              "anyOf": [
                {
                  "const": ""
                },
                {
                  "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$",
                  "maxLength": 253
                }
              ]
            },
            "externalSecret": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "enabled",
                "server",
                "mount",
                "authMount",
                "role",
                "audience",
                "serviceAccount",
                "caBundle",
                "refreshInterval",
                "data"
              ],
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "server": {
                  "type": "string",
                  "pattern": "^https://",
                  "description": "Tylko TLS: przez to połączenie idą tokeny i wartości."
                },
                "mount": {
                  "type": "string",
                  "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
                },
                "authMount": {
                  "type": "string",
                  "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
                },
                "role": {
                  "type": "string",
                  "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
                },
                "audience": {
                  "type": "string",
                  "minLength": 1
                },
                "serviceAccount": {
                  "type": "string",
                  "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
                },
                "caBundle": {
                  "type": "string",
                  "description": "CA serwera OpenBao, PEM w base64."
                },
                "caConfigMap": {
                  "type": "string",
                  "pattern": "^([a-z0-9]([a-z0-9-]*[a-z0-9])?)?$",
                  "description": "ConfigMapa z kluczem ca.crt w przestrzeni wydania — CA serwera OpenBao bez wartości z klastra w wartościach charta (decyzja 81)."
                },
                "refreshInterval": {
                  "type": "string",
                  "pattern": "^[0-9]+(s|m|h)$"
                },
                "data": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "secretKey",
                      "key",
                      "property"
                    ],
                    "properties": {
                      "secretKey": {
                        "type": "string",
                        "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
                      },
                      "key": {
                        "type": "string",
                        "pattern": "^[a-z0-9-]+(/[a-z0-9-]+)*$"
                      },
                      "property": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "hostname",
        "gateway",
        "requestTimeoutSeconds",
        "envoyGatewayPolicies",
        "upstreamIdleTimeoutSeconds",
        "paths"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "hostname": {
          "type": "string",
          "maxLength": 253,
          "pattern": "^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]{2,63}$"
        },
        "gateway": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "namespace",
            "sectionName"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "namespace": {
              "type": "string",
              "minLength": 1
            },
            "sectionName": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "requestTimeoutSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "envoyGatewayPolicies": {
          "type": "boolean",
          "description": "BackendTrafficPolicy wymaga CRD Envoy Gateway — false u klienta z inną implementacją Gateway API."
        },
        "upstreamIdleTimeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "description": "Musi być krótszy niż api.config.service.keep_alive_seconds; pilnuje tego szablon."
        },
        "paths": {
          "type": "array",
          "minItems": 1,
          "description": "Ścieżki wystawione przez Gateway — tylko publiczne API.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "value"
            ],
            "properties": {
              "type": {
                "enum": [
                  "PathPrefix",
                  "Exact"
                ]
              },
              "value": {
                "type": "string",
                "pattern": "^/[a-z0-9/._-]*$"
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "quantities": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "cpu",
          "memory",
          "ephemeral-storage"
        ]
      },
      "additionalProperties": {
        "type": [
          "string",
          "number"
        ]
      }
    }
  }
}
