# Materiały kursu — nie nasze, nie publikujemy.
# Własna dokumentacja projektu jest wyjęta spod ignorowania poniżej,
# bo docs/DECYZJE.md musi być widoczne w repozytorium.
docs/*
!docs/DECYZJE.md
!docs/RUNBOOK.md
!docs/INSTALACJA.md
!docs/WYMAGANIA.md

# Roboczy korpus do indeksowania (Etap 6).
# Deterministyczny korpus testowy dla e2e siedzi w tests/corpus/ i jest wersjonowany.
dokumenty/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/

# Generowane przy budowaniu — źródłem prawdy jest git, nie plik w drzewie.
version.json
dist/

# Pamięć podręczna pobranych artefaktów (charty), weryfikowanych sumą z ci/lib.sh.
.cache/

# mise: pobrany mise i narzędzia (./bin/mise trzyma je w projekcie).
.mise/

# Lokalne nadpisania
.env
*.local.yaml
kubeconfig*
# mise ładuje mise.local.toml obok mise.toml — osobiste ustawienia i sekrety,
# które nie mogą trafić do repozytorium.
mise.local.toml
mise.*.local.toml
mise.local.lock
